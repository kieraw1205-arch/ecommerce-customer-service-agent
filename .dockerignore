**
!requirements.lock
!customer-service-backend/
!customer-service-backend/my_agent/
!customer-service-backend/my_agent/*.py
!customer-service-backend/tests/
!customer-service-backend/tests/*.py
!customer-service-backend/scripts/
!customer-service-backend/scripts/test_all.py
!customer-service-backend/examples/
!customer-service-backend/examples/*.py
!customer-service-backend/evaluation/
!customer-service-backend/evaluation/*.py
!customer-service-backend/evaluation/*.json
!customer-service-backend/evaluation/holdout_v1/
!customer-service-backend/evaluation/holdout_v1/*.py
!customer-service-backend/evaluation/holdout_v1/inputs.json
!customer-service-backend/evaluation/holdout_v1/labels.json
# Final exclusions also cover directories with explicitly included parents.
**/.env
**/.env.*
**/.runtime*/**
**/data/**
**/*.sqlite*
**/*.db
**/__pycache__/**
**/.venv/**
**/node_modules/**
**/dist/**
**/._*
